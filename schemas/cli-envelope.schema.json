{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stcli.invalid/schemas/cli-envelope.schema.json",
  "title": "STcli CLI Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ok", "command", "data", "error", "warnings"],
  "properties": {
    "schema": { "const": "stcli.cli/v1" },
    "ok": { "type": "boolean" },
    "command": { "type": "string", "minLength": 1 },
    "data": true,
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "details": true
          }
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
