        "scan_depth": 2,
        "recursive": true,
        "max_recursion_steps": 8,
        "budget_tokens": 100,
        "case_sensitive": false,
        "match_whole_words": false,
        "use_group_scoring": false,
        "generation_type": "normal",
        "rng_seed": 7,
        "message_count": 1,
        "prior_activations": {}
      },
      "expected_activated": [
        "archive",
        "archivist"
      ],
      "expected_outcomes": {
        "archive": "activated",
        "archivist": "activated"
      }
    },
