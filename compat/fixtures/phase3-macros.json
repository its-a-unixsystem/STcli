          "expected_text": ""
        },
        {
          "id": "macro.deleteglobalvar.boundary-missing",
          "input": "{{deleteglobalvar::nonexistent}}",
          "expected_text": ""
        },
        {
          "id": "macro.getvar.boundary-missing",
          "input": "{{getvar::nonexistent}}",
          "expected_text": ""
