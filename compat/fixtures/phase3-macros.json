        {
          "id": "macro.deletevar.positive",
          "input": "{{setvar::trash::x}}{{deletevar::trash}}{{hasvar::trash}}",
          "expected_text": "false",
          "expected_local": {}
        },
        {
          "id": "macro.deleteglobalvar.positive",
          "input": "{{setglobalvar::gtrash::x}}{{deleteglobalvar::gtrash}}{{hasglobalvar::gtrash}}",
          "expected_text": "false",
          "expected_global": {}
        },
        {
          "id": "macro.hasvar.positive",
          "input": "{{setvar::seen::1}}{{hasvar::seen}}",
          "expected_text": "true",
          "expected_local": {
            "seen": "1"
          }
        },
        {
          "id": "macro.hasvar.boundary-missing",
          "input": "{{hasvar::unseen}}",
          "expected_text": "false",
          "expected_local": {}
        },
        {
          "id": "macro.hasglobalvar.positive",
          "input": "{{setglobalvar::g::1}}{{hasglobalvar::g}}",
          "expected_text": "true",
          "expected_global": {
            "g": "1"
          }
        },
        {
          "id": "macro.hasglobalvar.boundary-missing",
          "input": "{{hasglobalvar::g}}",
          "expected_text": "false",
          "expected_global": {}
        },
        {
          "id": "macro.getglobalvar.positive",
          "input": "{{setglobalvar::city::Tokyo}}{{getglobalvar::city}}",
          "expected_text": "Tokyo",
          "expected_global": {
            "city": "Tokyo"
          }
        },
        {
          "id": "macro.getglobalvar.boundary-missing",
          "input": "{{getglobalvar::missing}}",
          "expected_text": "{{getglobalvar::missing}}",
          "expected_global": {},
          "expected_warnings": 1
        },
        {
          "id": "macro.else.fallback-when-false",
          "input": "{{if::false}}yes{{else}}no{{/if}}",
          "expected_text": "no",
          "expected_local": {}
        },
        {
          "id": "macro.if.nested-ordering",
          "input": "{{if::true}}outer{{if::false}}inner{{else}}alt{{/if}}{{/if}}",
          "expected_text": "outeralt",
          "expected_local": {}
        }
      ]
