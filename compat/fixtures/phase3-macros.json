{
  "schema": "stcli.fixture-suite/v2",
  "profile": "sillytavern-1.18-core",
  "cases": [
    {
      "kind": "macro-render",
      "id": "macro.unknown.preserve-literal",
      "name": "unknown macro is preserved",
      "input": "before {{platformMacro::x}} after",
      "context": {},
      "initial_local": {},
      "initial_global": {},
      "expected_text": "before {{platformMacro::x}} after",
      "expected_local": {},
      "expected_global": {},
      "expected_warnings": 1
    }
  ],
  "macro_groups": [
    {
      "defaults": {
        "context": {
          "char": "Alice"
        },
        "initial_local": {
          "Alice_mood": "happy"
        },
        "initial_global": {},
        "expected_warnings": 0
      },
      "cases": [
        {
          "id": "macro.char.plain",
          "input": "{{char}}",
          "expected_text": "Alice",
          "expected_local": {
            "Alice_mood": "happy"
          }
        },
        {
          "id": "macro.char.nested-lookup",
          "input": "{{getvar::{{char}}_mood}}",
          "expected_text": "happy",
          "expected_local": {
            "Alice_mood": "happy"
          }
        },
        {
          "id": "macro.getvar.nested-brace",
          "input": "{{getvar::{{char}}_mood}}",
          "expected_text": "happy",
          "expected_local": {
            "Alice_mood": "happy"
          }
        }
      ]
    },
    {
      "defaults": {
        "context": {},
        "initial_local": {},
        "initial_global": {},
        "expected_warnings": 0
      },
      "cases": [
        {
          "id": "macro.if.discard-no-side-effects",
          "input": "{{if::false}}{{setvar::bad::1}}{{else}}{{setvar::good::2}}ok{{/if}}",
          "expected_text": "ok",
          "expected_local": {
            "good": "2"
          }
        },
        {
          "id": "macro.setvar.shorthand-add",
          "input": "{{.score = 1}}{{.score += 2}}{{.score}}",
          "expected_text": "3",
          "expected_local": {
            "score": "3"
          }
        },
        {
          "id": "macro.setglobalvar.global-scope",
          "input": "{{setglobalvar::weather::rain}}{{getglobalvar::weather}}",
          "expected_text": "rain",
          "expected_global": {
            "weather": "rain"
          }
        },
        {
          "id": "macro.setvar.utf8-args",
          "input": "{{setvar::greeting::\u65e5\u672c\ud83d\ude42}}{{getvar::greeting}}",
          "expected_text": "\u65e5\u672c\ud83d\ude42",
          "expected_local": {
            "greeting": "\u65e5\u672c\ud83d\ude42"
          }
        },
        {
          "id": "macro.newline.plain",
          "input": "a{{newline}}b",
          "expected_text": "a\nb"
        },
        {
          "id": "macro.space.plain",
          "input": "a{{space}}b",
          "expected_text": "a b"
        },
        {
          "id": "macro.noop.plain",
          "input": "a{{noop}}b",
          "expected_text": "ab"
        },
        {
          "id": "macro.//.plain",
          "input": "a{{// hidden}}b",
          "expected_text": "ab"
        },
        {
          "id": "macro.trim.plain",
          "input": "{{trim::  hello  }}",
          "expected_text": "hello"
        },
        {
          "id": "macro.reverse.plain",
          "input": "{{reverse::abc}}",
          "expected_text": "cba"
        }
      ]
    },
